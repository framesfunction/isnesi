# ---------------------------------------------------------------------------
# ISNESI environment configuration
# Copy to `.env.local` for development. Never commit real values.
# ---------------------------------------------------------------------------

# Public values — these are embedded in the browser bundle. Never put secrets here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Server-only secrets. Never prefix these with NEXT_PUBLIC_ and never import them
# from a Client Component. Used only by server-side admin/Edge workflows.
SUPABASE_SERVICE_ROLE_KEY=

# Direct-connection credential for DB operations run by npm scripts
# (migrations: `npm run supabase -- db push --remote ...`, types: npm run db:types).
# The database host is IPv6-only for most projects, so these scripts connect via
# the AWS session pooler; the project ref comes from NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_DB_PASSWORD=
# Only if the project lives outside the default region (`aws-0-eu-west-1`):
# SUPABASE_POOLER_REGION=aws-0-eu-west-1

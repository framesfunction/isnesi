# ---------------------------------------------------------------------------
# ISNESI environment configuration
# Copy to `.env.local` for development. Never commit real values.
# ---------------------------------------------------------------------------

# Public values — these are embedded in the browser bundle. Never put secrets here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Server-only secrets. Never prefix these with NEXT_PUBLIC_ and never import them
# from a Client Component. Used only by server-side admin/Edge workflows.
SUPABASE_SERVICE_ROLE_KEY=

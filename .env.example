# ---------------------------------------------------------------------------
# ISNESI environment configuration
# Copy to `.env.local` for development. Never commit real values.
# ---------------------------------------------------------------------------

# Public values — these are embedded in the browser bundle. Never put secrets here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Server-only secrets. Never prefix these with NEXT_PUBLIC_ and never import them
# from a Client Component. Used only by server-side admin/Edge workflows.
SUPABASE_SERVICE_ROLE_KEY=

# Secret shared with the cron caller (e.g. Vercel Cron) for the scheduled
# publishing endpoint. The route fails closed (503) when this is unset.
CRON_SECRET=

# Direct-connection credential for DB operations run by npm scripts
# (migrations: `npm run supabase -- db push --remote ...`, types: npm run db:types,
# seed/media: npm run db:seed). The database host is IPv6-only for most projects,
# so these scripts connect via the AWS session pooler; the project ref comes
# from NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_DB_PASSWORD=
# Only if the project lives outside the default region (`aws-0-eu-west-1`):
# SUPABASE_POOLER_REGION=aws-0-eu-west-1
# Or provide a complete pooler URL override instead:
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# The full MTN MoMo secret set lives on the deployed Edge Functions (see
# supabase/functions/README.md). This app itself reads MOMO_API_USER solely as
# a gate: the donate page keeps online giving closed until it is set.
# MOMO_API_USER=
